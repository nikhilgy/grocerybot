# Telegram
BOT_TOKEN=                     # From @BotFather on Telegram
WEBHOOK_URL=                   # e.g. https://your-app.up.railway.app/webhook

# Claude
ANTHROPIC_API_KEY=             # From console.anthropic.com

# Voice transcription (Groq Whisper, whisper-large-v3-turbo)
GROQ_API_KEY=                  # From console.groq.com

# Swiggy Instamart MCP
SWIGGY_MCP_ENDPOINT=https://mcp.swiggy.com/im
SWIGGY_ACCESS_TOKEN=           # Obtained via OAuth flow on first run
SWIGGY_REFRESH_TOKEN=          # Obtained via OAuth flow on first run
# Delivery address is chosen in-chat via the /address command (stored in the DB)

# Database
DATABASE_PATH=data/grocerybot.db
